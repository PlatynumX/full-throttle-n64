# Full Throttle N64 r2v
# ScummVM 1.6.0 + libdragon backend.

srcdir := ../../..
VPATH := $(srcdir)
BUILD_DIR := build
SOURCE_DIR := $(srcdir)

include $(N64_INST)/include/n64.mk

# Old ScummVM emits warnings that modern libdragon promotes via -Werror.
# Filter it at the source so n64.mk target-specific flag propagation cannot
# accidentally re-introduce it for object prerequisites.
N64_CFLAGS := $(filter-out -Werror,$(N64_CFLAGS))
# ScummVM 1.6.0 predates C++17. Force a compatible dialect instead of
# inheriting libdragon's current default.
N64_CXXFLAGS := $(filter-out -Werror -std=gnu++17,$(N64_CXXFLAGS)) -std=gnu++11

# n64.mk defines defaults, so project-specific metadata must follow the include.
N64_ROM_TITLE := "FT64 R2V V18"
N64_ROM_REGIONFREE := true
N64_ROM_CONTROLLER1 := n64

CC := $(N64_CC)
CXX := $(N64_CXX)
AS := $(N64_AS)
AR := $(N64_AR) rcs
RANLIB := $(N64_GCCPREFIX_TRIPLET)ranlib

# libdragon's %.z64 target owns propagation of N64_CFLAGS/N64_CXXFLAGS/
# N64_ASFLAGS/N64_LDFLAGS to the ELF and object prerequisite chain. Do not
# seed the generic flags with N64_* here or every platform flag is duplicated.
CFLAGS :=
CXXFLAGS := -fno-rtti -fno-exceptions
ASFLAGS :=
LDFLAGS :=

# ScummVM's generic make rules expect these helpers to be supplied by the port.
DEPDIR := .deps
MKDIR := mkdir -p
RM := rm -f
RM_REC := rm -rf
HAVE_GCC3 := 1
VERBOSE_BUILD := 1
USE_RGB_COLOR := 0

# ScummVM 1.6.0 portability/build defines.
DEFINES += -D__N64__
DEFINES += -DN64_LIBDRAGON
DEFINES += -DSYSTEM_NOT_SUPPORTING_D_TYPE
DEFINES += -DDISABLE_FANCY_THEMES
DEFINES += -DDISABLE_DOSBOX_OPL
DEFINES += -DDISABLE_TEXT_CONSOLE
DEFINES += -DN64_EXTREME_MEMORY_SAVING
DEFINES += -DN64_FT_ONLY
DEFINES += -DDISABLE_HELP
DEFINES += -DDISABLE_TOWNS_DUAL_LAYER_MODE

# ScummVM 1.6.0 engine sources include headers as e.g. "scumm/scumm.h".
# Its historical N64 Makefile therefore exposed both the source root and
# $(srcdir)/engines. Keep that source-layout contract in the libdragon port.
INCLUDES += -I. -I$(srcdir) -I$(srcdir)/engines

BACKEND := n64libdragon
ENABLED := STATIC_PLUGIN
ENABLE_SCUMM := $(ENABLED)
ENABLE_SCUMM_7_8 := $(ENABLED)

OBJS := \
	backends/platform/n64libdragon/nintendo64_libdragon.o \
	backends/platform/n64libdragon/osys_n64_libdragon.o \
	backends/platform/n64libdragon/n64libdragon-fs.o

include $(srcdir)/Makefile.common

# GNU ld scans static archives from left to right. Makefile.common places
# gui/libgui.a before engines/libengines.a, but SCUMM's engine dialogs reference
# AboutDialog, SaveLoadChooser, and OptionsDialog from libgui. r2v removed the
# launcher roots that previously caused those GUI members to be extracted early,
# exposing the latent archive-order dependency. Move libgui directly after the
# generic engine archive while leaving video/graphics/audio/common later.
FT64_GUI_ARCHIVE := gui/libgui.a
OBJS := $(filter-out $(FT64_GUI_ARCHIVE),$(OBJS))
OBJS := $(subst engines/libengines.a,engines/libengines.a $(FT64_GUI_ARCHIVE),$(OBJS))

TARGET := full-throttle-n64-r2v-v18

all: $(TARGET).z64

$(BUILD_DIR)/$(TARGET).elf: $(OBJS)

clean:
	$(RM_REC) $(BUILD_DIR) $(TARGET).z64

.PHONY: all clean
