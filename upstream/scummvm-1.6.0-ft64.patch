-	readPalette(_pal, b);
-	setDirtyColors(0, 255);
+	b.read(headerContent, subSize);
+	const byte headerMajorVersion = headerContent[0];
+	const byte headerMinorVersion = headerContent[1];
+	_nbframes = READ_LE_UINT16(&headerContent[2]);
+
+	// Full Throttle (and the DIG demo) can encode the correct frame rate in
+	// the AHDR/FLU header. Backported from ScummVM upstream commit 9e7e6a08.
+	if (_vm->_game.id == GID_FT || (_vm->_game.id == GID_DIG && (_vm->_game.features & GF_DEMO))) {
+		if (headerMajorVersion > 1 && subSize >= 0x300 + 8) {
+			const uint16 speed = READ_LE_UINT16(&headerContent[6 + 0x300]);
+			if ((_curVideoFlags & 8) == 0 && speed != 0) {
+				debug(5, "SmushPlayer::handleAnimHeader(): header version %d.%d, video speed override %d fps (cur speed %d)",
+					headerMajorVersion, headerMinorVersion, speed, _speed);
+				_speed = speed;
+			}
+		}
+	}
+
+	if (!_skipPalette) {
+		memcpy(_pal, &headerContent[6], sizeof(_pal));
+		setDirtyColors(0, 255);
+	}
+
+	free(headerContent);
 }
 
